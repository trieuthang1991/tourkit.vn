c","w":150,"h":150},{"src":"https://tourkit.vn/wp-content/uploads/2024/06/logo-15.png","alt":"logo-15","w":150,"h":150},{"src":"https://tourkit.vn/wp-content/uploads/2024/06/logo-14.png","alt":"logo-14","w":150,"h":150},{"src":"https://tourkit.vn/wp-content/uploads/2024/06/logo-16.png","alt":"logo-16","w":150,"h":150}],"bgImages":[],"links":[]},{"i":26,"id":"daddbe4","bg":"rgba(0, 0, 0, 0)","bgImg":null,"text":"","heads":[],"images":[],"bgImages":[],"links":[]},{"i":27,"id":"74bc361","bg":"rgba(0, 0, 0, 0)","bgImg":null,"text":"Khách hàng nói về Tourkit","heads":[{"tag":"H2","t":"Khách hàng nói về Tourkit","color":"rgb(0, 0, 0)","size":"40px","weight":"700"}],"images":[],"bgImages":[],"links":[]},{"i":28,"id":"090c3b7","bg":"rgba(0, 0, 0, 0)","bgImg":null,"text":"","heads":[],"images":[],"bgImages":[],"links":[]},{"i":29,"id":"59899e3","bg":"rgb(255, 255, 255)","bgImg":null,"text":"Feedback khách hàng\nKhách hàng nói về\nTourkit\n20K\n\nNgười dùng hệ thống\n\n4.8/5\n\nĐánh giá Chất lượng phục vụ\n\nTìm hiểu thêm\nTheo dõi\nYoutube\n    \nVới Cương Vị CEO của Vietbluetour và đã sử dụng dịch vụ rất nhiều đơn vị để chuyển đổi số nhưng Tôi đã thực sự bị thuyết phục bởi hệ thống ngày càng tối ưu và linh hoạt song song với đội ngũ trẻ năng động support bất cứ lúc nào nhân sự cần vì vậy không có bất cứ lý do gì để Vietbluetour không tiếp tục đồng hành sử dụng Tourkit trong những năm sắp tới !\n\nNGUYỄN MINH HẰNG - CEO VIETBLUETOUR / Chuyển Đổi Số Doanh Nghiệp Du Lịch\n\n    \nCảm ơn admin với bài đăng này. Mình là Nguyễn Tiến Đức - Giám đốc của HanVina Travel. Ngày 25/01/2024 là ngày hai bên đặt bút ký hợp đồng, chuyển khoản thanh toán và bắt đầu triển khai đưa vào ứng dụng trong doanh nghiệp của mình. Đến thời điểm này, mọi thứ đang rất ổn định và trơn tru. Đường dài chưa biết sẽ như thế nào, nhưng cho đến thời điểm này, mình cảm thấy vô cùng hài lòng với chất lượng của Tourkit.\n\nNGUYỄN TIẾN ĐỨC / Giám Đốc Của HanVina Travel\n\n    \nBên mình mới sử dụng, còn gặp vướng mắc rất nhiều. Về chất lượng của phần mềm thì xin phép vào đánh giá lại sau 6 tháng - 1 năm sử dụng. Tuy nhiên về support thì 100đ không có nhưng. Bạn Trà My hỗ trợ rất tốt ngay cả những ngày lễ & sáng sớm như hôm nay. Cảm ơn My & Team nhiều!\n\nPHẠM ANH NGUYỆT / CEO SeA Travel","heads":[{"tag":"H2","t":"Feedback khách hàng","color":"rgb(88, 66, 188)","size":"12px","weight":"400"},{"tag":"H2","t":"Khách hàng nói về Tourkit","color":"rgb(0, 0, 0)","size":"40px","weight":"700"},{"tag":"H2","t":"20K","color":"rgb(88, 66, 188)","size":"30px","weight":"700"},{"tag":"H2","t":"4.8/5","color":"rgb(88, 66, 188)","size":"30px","weight":"700"}],"images":[{"src":"https://tourkit.vn/wp-content/uploads/2023/04/Artboard-15@3x-1.png","alt":"","w":0,"h":0},{"src":"https://tourkit.vn/wp-content/uploads/2023/04/Artboard-15@3x.png","alt":"","w":0,"h":0},{"src":"https://tourkit.vn/wp-content/uploads/2024/03/412548980_7822125134471460_5770019805630433419_n.jpg","alt":"","w":960,"h":960},{"src":"https://tourkit.vn/wp-content/uploads/2024/03/348837775_1006283790737007_6691397982631616011_n.jpg","alt":"","w":2047,"h":2048},{"src":"https://tourkit.vn/wp-content/uploads/2024/03/333141560_746489096846873_6085406668069143648_n.jpg","alt":"","w":2048,"h":2048},{"src":"https://tourkit.vn/wp-content/uploads/2022/11/contact_globe.svg","alt":"","w":0,"h":0}],"bgImages":[],"links":[{"t":"Tìm hiểu thêm","href":"https://tourkit.vn/#0"},{"t":"Theo dõi Youtube","href":"https://www.youtube.com/watch?v=-Zl9R9w6MU0"}]},{"i":30,"id":"a70901a","bg":"rgba(0, 0, 0, 0)","bgImg":null,"text":"Feedback khách hàng\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\tKhách hàng nói về \n Tourkit","heads":[{"tag":"H2","t":"Feedback khách hàng","color":"rgb(88, 66, 188)","size":"12px","weight":"400"},{"tag":"H2","t":"Khách hàng nói về Tourkit","color":"rgb(0, 0, 0)","size":"40px","weight":"700"}],"images":[],"bgImages":[],"links":[]},{"i":31,"id":"03df165","bg":"rgba(0, 0, 0, 0)","bgImg":null,"text":"Hoạt động của chúng tô