<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting cho Next.js standalone qua HttpPlatformHandler.
  IIS tu chay `node server.js` va chuyen tiep request vao do.
  Da chay OK tren Windows Server 2012 R2 (IIS 8.5).

  Xem huong dan day du: deploy/DEPLOY-IIS.md

  Sua truoc khi dung:
    - processPath      : duong dan node.exe that tren server
    - ADMIN_PASSWORD   : mat khau admin that
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpplatformhandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform
        processPath="C:\Program Files\nodejs\node.exe"
        arguments="server.js"
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\node"
        startupTimeLimit="60"
        startupRetryCount="3">
      <environmentVariables>
        <!-- IIS cap 1 cong trong va truyen vao day; Next doc bien PORT. -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Windows Server 2012 R2: bo qua kiem tra nen tang cua Node moi.
             Bo dong nay neu server la Windows Server 2016+ . -->
        <environmentVariable name="NODE_SKIP_PLATFORM_CHECK" value="1" />
        <!-- DOI thanh mat khau that -->
        <environmentVariable name="ADMIN_PASSWORD" value="DOI_MAT_KHAU_NAY" />
      </environmentVariables>
    </httpPlatform>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
