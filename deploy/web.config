<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + iisnode config for the Next.js standalone server (server.js).

  Requirements on the server:
    1. Node.js 24+ installed (node.exe on PATH)
    2. iisnode module installed  (https://github.com/Azure/iisnode/releases)
    3. URL Rewrite module installed (https://www.iis.net/downloads/microsoft/url-rewrite)

  Point the IIS site's physical path at the deployed bundle folder (the one
  containing server.js and this web.config). iisnode assigns the port
  automatically via a named pipe, so no PORT setting is needed here.

  IMPORTANT — set these as environment variables on the server (App Pool >
  Advanced Settings, or a machine/user env var) so they reach the Node process:
    ADMIN_PASSWORD  = <your real admin password>   (do NOT rely on the default)
  Note: NEXT_PUBLIC_SITE_URL is baked in at build time, so set it before
  running `npm run bundle`, not here.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Let the Next.js server handle every request (static + dynamic). -->
        <rule name="nextjs">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      nodeProcessCommandLine="node.exe"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false" />

    <!-- Let Next.js render its own 404/500 instead of IIS pages. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Serve PDFs and static assets with the correct type. -->
    <staticContent>
      <remove fileExtension=".pdf" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
